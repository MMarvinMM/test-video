<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
		PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
		"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinatower.platform.mapper.ISysUserMapper">

	<select id="selectUserOnlyByUserName" parameterType="String" resultType="com.chinatower.platform.entity.admin.SysUser">
		select * from sys_user u
		where u.del_flag = '0' AND u.user_name = #{userName}
	</select>
</mapper>
