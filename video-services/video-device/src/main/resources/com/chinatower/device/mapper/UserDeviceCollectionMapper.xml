<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinatower.device.mapper.UserDeviceCollectionMapper">

    <resultMap id="BaseResultMap" type="com.chinatower.device.dataobject.UserDeviceCollection">
            <id property="userDeviceCollId" column="user_device_coll_id" jdbcType="BIGINT"/>
            <result property="userId" column="user_id" jdbcType="BIGINT"/>
<!--            <result property="channelCode" column="channel_code" jdbcType="VARCHAR"/>-->
    </resultMap>

    <sql id="Base_Column_List">
        user_device_coll_id,user_id,channel_code
    </sql>

    <select id="getChanInfoByChanCode" resultType="com.chinatower.device.dataobject.ChannelInfoDO">
        SELECT
            DISTINCT
            device_code,
            channel_code
        FROM
            vm_channel_info_t
        WHERE delete_flag = '0'AND
                device_code in ( SELECT device_code FROM vm_channel_info_t WHERE channel_code = #{channelCode} )
    </select>

    <select id="getDeviceByChanCode" resultType="java.lang.String">
        SELECT DISTINCT device_code FROM vm_channel_info_t WHERE channel_code in
        <foreach collection="list" item="item" index="index" open="(" close=")" separator=",">
            #{item}
        </foreach>
    </select>

    <select id="getChanCollInfo" resultType="java.lang.Integer">
        SELECT
            count(*)
        FROM
            vm_user_device_collection_t
        WHERE
            user_id = #{userId}
          AND coll_obj_type = #{collType}
          AND coll_obj_code IN
        <foreach collection="list" item="item" index="index" open="(" close=")" separator=",">
            #{item}
        </foreach>
    </select>

    <select id="queryCollections" resultType="com.chinatower.device.entity.vo.UserDeviceCollectionQueryVO">
        SELECT
            user_id, coll_obj_type, coll_obj_code
        FROM
            vm_user_device_collection_t
        WHERE
            user_id = #{userId}
            <if test="collObjTypeList != null and collObjTypeList.size() > 0 ">
                AND coll_obj_type IN
                <foreach collection="collObjTypeList" item="item" index="index" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
    </select>
</mapper>
