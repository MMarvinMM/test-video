    <select id="getTenantDeviceRelList" resultType="com.chinatower.platform.entity.devicemgmt.vo.TenantDeviceRelVO"
            parameterType="com.chinatower.platform.entity.devicemgmt.vo.TenantDeviceRelVO">
        SELECT  id, device_code, tenant_id, channel_code, channel_name,industry_code,
        app_ver_code,creator,create_time,modifier,update_time,delete_flag
        FROM vm_tenant_device_channel_common_rel_t t WHERE t.delete_flag = '0' and t.device_type = #{deviceType}
        <if test='tenantId != null and tenantId != ""'>
            AND tenant_id= #{tenantId}
        </if>
        <if test='deviceCode != null and deviceCode != ""'>
            AND device_code= #{deviceCode}
        </if>
        <if test='channelCode != null and channelCode != ""'>
            AND channel_code= #{channelCode}
        </if>
        <if test='industryCode != null and industryCode != ""'>
            AND industry_code= #{industryCode}
        </if>
        <if test="channelCodeList != null and channelCodeList.size()>0 ">
            and channel_code in
            <foreach collection="channelCodeList" item="item" index="index" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
        order by update_time desc
    </select>

    <insert id="addTenantChannelCommonRel" parameterType="java.util.List">
        insert into vm_tenant_device_channel_common_rel_t(device_code,tenant_id,channel_code,channel_name,
        industry_code,app_ver_code,creator,create_time,modifier,update_time,delete_flag, device_type)
        values
        <foreach collection="list" item="item" index="index" separator=",">
            (#{item.deviceCode},#{item.tenantId},#{item.channelCode},#{item.channelName},
            #{item.industryCode},#{item.appVerCode},#{item.creator},NOW(),#{item.creator},NOW(),'0', #{item.deviceType})
        </foreach>
    </insert>

    <update id="updateTenantChannelCommonRel" parameterType="java.util.List">
        <foreach collection="list" item="item" index="index" open="" close="" separator=";">
            update vm_tenant_device_channel_common_rel_t
            <set>
                <if test='item.channelName != null'>
                    channel_name = #{item.channelName, jdbcType=VARCHAR},
                </if>
                update_time = NOW(), modifier = #{item.creator, jdbcType=VARCHAR}
            </set>
            where id = #{item.id}
        </foreach>
    </update>
</mapper>
