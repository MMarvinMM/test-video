<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinatower.device.mapper.UavFlightControlPasswordConfMapper">
    <sql id="UavFlightControlPasswordConfFields">
        fcpc.id
        ,fcpc.device_code
        ,fcpc.password_status
        ,fcpc.password
        ,fcpc.error_times_limit
        ,fcpc.lock_time
        ,fcpc.lock_time_unit
        ,fcpc.delete_flag
        ,fcpc.creator
        ,fcpc.create_time
        ,fcpc.modifier
        ,fcpc.update_time
        ,fcpc.industry_code
        ,fcpc.tenant_id
        ,fcpc.app_ver_code
    </sql>

    <select id="queryUavFlightControlPasswordConf" resultType="com.chinatower.device.entity.dto.VmUavFlightControlPasswordConfDTO">
        select <include refid="UavFlightControlPasswordConfFields"/>
        from vm_uav_flight_control_password_conf fcpc
        where fcpc.delete_flag = '0'
        and fcpc.device_code = #{param.deviceCode}
        ${param.dataScope}
    </select>

    <delete id="batchDeleteFlightControlPasswordConf">
        delete from vm_uav_flight_control_password_conf fcpc
        where
        fcpc.delete_flag = '0'
        and fcpc.device_code in
        <foreach collection="deviceCodes" item="deviceCode" index="index" open="(" close=")" separator=",">
            #{deviceCode}
        </foreach>
        ${dataScope}
    </delete>

    <insert id="batchInsertFlightControlPasswordConf">
        insert into vm_uav_flight_control_password_conf(`device_code`,`password_status`, `password`, `error_times_limit`, `lock_time`, `lock_time_unit`,
        `creator`, `create_time`, `industry_code`, `tenant_id`, `app_ver_code`) values
        <foreach collection="list"  item="item" separator=",">
            (#{item.deviceCode},  #{item.passwordStatus}, #{item.password},  #{item.errorTimesLimit}, #{item.lockTime}, #{item.lockTimeUnit},
            #{item.creator}, now(),  #{item.industryCode}, #{item.tenantId}, #{item.appVerCode})
        </foreach>
    </insert>

</mapper>