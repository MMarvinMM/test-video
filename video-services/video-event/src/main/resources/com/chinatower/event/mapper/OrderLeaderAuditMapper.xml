    <select id="getLeaderListByFlow" resultType="java.util.Map" parameterType="java.util.Map">
        SELECT
        a.order_flow_id as orderFlowId,
        a.audit_id as auditId,
        a.leader_id as leaderId,
        IF(a.audit_time IS NULL,'',DATE_FORMAT(a.audit_time,'%Y-%m-%d %H:%i:%s')) as auditTime,
        IF(a.create_time IS NULL,'',DATE_FORMAT(a.create_time,'%Y-%m-%d %H:%i:%s')) AS handleTime,
        IFNULL(a.audit_content,'') AS auditContent,
        a.status status
        FROM vm_order_leader_audit_t a
        WHERE a.order_id = #{orderId,jdbcType=VARCHAR}
        <if test="orderFlowIdList!= null and orderFlowIdList.size() > 0 ">
            AND a.order_flow_id in
            <foreach collection="orderFlowIdList" item="labelIdItem" index="index" open="(" close=")" separator=",">
                #{labelIdItem}
            </foreach>
        </if>
        ORDER BY a.create_time DESC
    </select>

    <select id="getLeaderAuditInfo" resultType="java.util.Map" parameterType="java.lang.String">
        SELECT
        IFNULL(a.province_code,'') AS provinceId,
        IFNULL(a.city_code,'') AS cityId,
        IFNULL(a.county_code,'') AS countyId,
        a.tenant_id AS tenantId,
        a.order_id AS orderId,
        a.order_flow_id AS orderFlowId,
        a.alarm_body AS alarmBody,
        a.warning_type_id AS warningTypeId,
        IFNULL(a.alarm_time,'') AS alarmTime,
        IFNULL(a.create_time,'') AS applyTime,
        IFNULL(a.user_id,'') AS applyUserId,
        a.`status`,
        a.leader_id AS leaderId,
        IFNULL(a.audit_time,'') AS auditTime,
        a.emergency_level as emergencyLevel,
        a.content,
        a.voice,
        a.apply_voice as applyVoice,
        a.address,
        IFNULL(a.audit_content,'') as auditContent,
        a.order_status as orderStatus,
               a.enable_acceptance_mode as enableAcceptanceMode
        FROM vm_order_leader_audit_t a
        WHERE a.audit_id = #{auditId,jdbcType=VARCHAR}
        AND a.delete_flag = '0'
    </select>

