    <select id="selectByVmSatelliteLayerConfigDTO" resultType="com.chinatower.common.core.dto.bdm.VmSatelliteLayerConfigDTO">
        select
        c.id layerId,
        c.create_time createTime,
        c.layer_name layerName,
        c.custom_name customName,
        c.tenant_id tenantId,
        c.industry_code industryCode,
        c.app_ver_code appVerCode,
        c.polygon_count polygonCount,
        c.is_build_alarm isBuildAlarm,
        t.abbreviation,
        t.layer_temp_name layerTempName,
        t.warning_source warningSource,
        t.alarm_type alarmType,
        t.alarm_type_name alarmTypeName
        from vm_satellite_layer_config c
        left join vm_layer_template_config t on c.layer_template_id = t.id
        where c.delete_flag = 0
        and c.id = #{layerId}
    </select>

    <update id="updateIsBuildAlarm">
        update vm_satellite_layer_config
        set is_build_alarm = '1'
        where id = #{layerId}
    </update>

    <select id="getList" resultType="com.chinatower.common.core.vo.SatelliteLawConfigVo">
        select id, file_name, custom_name, alarm_type_id, layer_template_id, file_url ,is_build_alarm, creator, create_time, modifier, update_time , tenant_id, industry_code, app_ver_code
        from `vm_satellite_layer_config` s
        <where>
            <if test="id != null and id !=''">
                and id = #{id}
            </if>
            <if test="fileName != null and fileName !=''">
                and file_name like CONCAT('%', #{fileName}, '%')
            </if>
            <if test="customName != null and customName !=''">
                and custom_name like CONCAT('%', #{customName}, '%')
            </if>
            <if test="alarmTypeId != null and alarmTypeId !=''">
                and alarm_type_id = #{alarmTypeId}
            </if>
            <if test="layerTemplateIdList != null and layerTemplateIdList.size > 0">
                and layer_template_id in
                <foreach item="item" index="index" collection="layerTemplateIdList" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <if test="creator != null and creator !=''">
                and creator like CONCAT('%', #{creator}, '%')
            </if>
            <if test="modifier != null and modifier !=''">
                and modifier like CONCAT('%', #{modifier}, '%')
            </if>
            <if test="createStartTime != null and createStartTime !=''">
                and create_time &gt;= #{createStartTime}
            </if>
            <if test="createEndTime != null and createEndTime !=''">
                and create_time &lt;= #{createEndTime}
            </if>
            <if test="updateStartTime != null and updateStartTime !=''">
                and update_time &gt;= #{updateStartTime}
            </if>
            <if test="updateEndTime != null and updateEndTime !=''">
                and update_time &lt;= #{updateEndTime}
            </if>
            and delete_flag = 0
             ${dataScope}
        </where>
        <choose>
            <when test="createDateOrder != null and createDateOrder.toLowerCase() == 'asc'">
                order by create_time asc
            </when>
            <when test="createDateOrder != null and createDateOrder.toLowerCase() == 'desc'">
                order by create_time desc
            </when>
            <when test="updateDateOrder != null and updateDateOrder.toLowerCase() == 'asc'">
                order by update_time asc
            </when>
            <when test="updateDateOrder != null and updateDateOrder.toLowerCase() == 'desc'">
                order by update_time desc
            </when>
            <otherwise>
                order by create_time desc
            </otherwise>
        </choose>
    </select>


    <select id="getLayerInfo" resultType="com.chinatower.bdm.modules.inspectionRoute.entity.LayerInfoVO">
        select s.id, s.layer_area, s.layer_name, s.layer_namespace, s.layer_template_id as layerTypeId,l.layer_temp_name as layerTypeName,l.abbreviation
        from `vm_satellite_layer_config` s
        left join vm_layer_template_config l on s.layer_template_id = l.id
        <where>
            <if test="id != null and id !=''">
                and s.id = #{id}
            </if>
        </where>
    </select>



    <update id="updateConfig" parameterType="com.chinatower.common.core.vo.SatelliteLawConfigVo">
        UPDATE `vm_satellite_layer_config` SET
        <if test='customName != null and customName != ""'>
            `custom_name` = #{customName},
        </if>
        <if test='modifier != null and modifier != ""'>
            `modifier` = #{modifier},
        </if>
        `update_time` = now()
        WHERE `id` = #{id};
    </update>

    <update id="deleteConfig" parameterType="com.chinatower.common.core.vo.SatelliteLawConfigVo">
        UPDATE `vm_satellite_layer_config` SET
         `delete_flag` = '1',
         `modifier` = #{modifier},
         `update_time` = now()
         WHERE `id` = #{id};
    </update>

    <select id="getConfigByOne" resultType="com.chinatower.common.core.vo.SatelliteLawConfigVo">
        select id, file_name, alarm_type_id, layer_template_id, file_url , creator, create_time, modifier, update_time , tenant_id, industry_code, app_ver_code
        from `vm_satellite_layer_config` s
        <where>
            <if test="fileName != null and fileName !=''">
                and file_name = #{fileName}
            </if>
            and delete_flag = 0
            ${dataScope}
        </where>
    </select>

    <select id="getAlarmType" resultType="java.util.Map">
        SELECT type_value as typeId,type_name as typeName FROM sys_alarm_type
        <where>
        <if test="typeList != null and typeList.size > 0">
            and type_value in
            <foreach item="item" index="index" collection="typeList" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        </where>
    </select>

    <select id="selectCustomNameCount" resultType="java.lang.Integer">
        select count(1)
        from vm_satellite_layer_config
        where
            delete_flag = '0'
          and tenant_id = #{tenantId}
          and industry_code = #{industryCode}
          and custom_name = #{customName}
    </select>

    <select id="selectCustomNameCountNotId" resultType="java.lang.Integer">
        select count(1)
        from vm_satellite_layer_config
        where
            delete_flag = '0'
          and tenant_id = #{tenantId}
          and industry_code = #{industryCode}
          and custom_name = #{customName}
          and id != #{id}
    </select>


