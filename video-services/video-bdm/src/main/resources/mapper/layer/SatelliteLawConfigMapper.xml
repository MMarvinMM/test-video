    <select id="getLayerTemplate" resultType="java.util.Map">
        SELECT id as templateId,layer_temp_name as templateName FROM vm_layer_template_config
        <where>
            <if test="templateList != null and templateList.size > 0">
                and id in
                <foreach item="item" index="index" collection="templateList" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
        </where>
    </select>

