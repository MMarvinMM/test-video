    <insert id="createTable">
        create table IF NOT EXISTS ${tableName} (like yjjbnt_ceshitable INCLUDING indexes including constraints including comments including defaults) ;
        CREATE SEQUENCE IF NOT EXISTS ${tableName}_gid_seq
            INCREMENT 1
            START 1
            MINVALUE 1
            MAXVALUE 2147483647
            CACHE 1;
        alter table ${tableName} alter column "gid" set default nextval('${tableName}_gid_seq');
    </insert>
    <insert id="createTableView">
        CREATE VIEW view_${tableName} AS
        SELECT gid, geom, bsm, minx, miny, maxx, maxy, TBBH, DLMC, YJJBNTTBMJ, GDPDJB
        FROM ${tableName}
    </insert>
    <update id="updateCalarea">
        update ${tableName}
        set minx = ST_X ( st_astext ( st_pointn ( ST_ExteriorRing ( ST_Envelope ( geom ) ), 1 ) ) ),
            miny = ST_Y ( st_astext ( st_pointn ( ST_ExteriorRing ( ST_Envelope ( geom ) ), 1 ) ) ),
            maxx = ST_X ( st_astext ( st_pointn ( ST_ExteriorRing ( ST_Envelope ( geom ) ), 3 ) ) ),
            maxy = ST_Y ( st_astext ( st_pointn ( ST_ExteriorRing ( ST_Envelope ( geom ) ), 3 ) ) ),
            calarea=st_area (st_transform ( geom, CAST ( ( FLOOR ( ( ST_X ( st_centroid ( geom ) ) + 1.5 ) / 3 ) + 4488 ) AS INTEGER ) ) )
        where calarea is null;
    </update>
    <select id="inspectionRoute" resultType="java.lang.String"
            parameterType="com.chinatower.gis.api.entity.layer.GetXjxlFeaturesByIdsReq">
        SELECT
        row_to_json(fc)
        FROM (
            SELECT
                'FeatureCollection' AS type,
                '212' AS id,
                array_to_json(array_agg(f)) AS features
            FROM (
                SELECT
                    'Feature' AS type
                    <if test="req.returnGeometry">
                        ,ST_AsGeoJSON(geom)::json as geometry
                    </if>
                ,(
                    SELECT
                    row_to_json(t)
                    FROM (
                        SELECT tbbh,bsm,dlmc,zldwmc
                        <if test="req.returnAllCols">
                            ,ysdm,xzqdm,xzqmc,yjjbnttbbh,dlbm,qsxz,qsdwdm,qsdwmc,zldwdm,yjjbnttbmj,kcdlbm,tkxs,tkmj,yjjbntmj,gdlx,yjjbntlx,gdpdjb,tbxhdm,tbxhmc,gdzzsxdm,gdzzsxmc,gddb,gddj,frdbs,sjnf,bz
                        </if>
                        ) AS t
                    ) AS properties
                    FROM ${tableName}
                    <where>
                        <if test="req.tbbhs != null and req.tbbhs.size() > 0">
                            and bsm in
                            <foreach collection="req.tbbhs" item="item"  open="(" close=")" separator=",">
                                #{item}
                            </foreach>
                        </if>
                    </where>
            ) AS f
        ) AS fc
    </select>

    <select id="inspectionRouteCount" resultType="java.lang.Integer">
        select
        count(1)
        from ${tableName}
        <where>
            <if test="req.tbbhs != null and req.tbbhs.size() > 0">
                and bsm in
                <foreach collection="req.tbbhs" item="item"  open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
        </where>
    </select>

    <select id="getLayerArea" resultType="java.lang.Double">
        select
            sum(yjjbnttbmj)
        from ${tableName}
    </select>
    <select id="getXlsjFeatures" resultType="java.lang.String">
        SELECT
        row_to_json(fc)
        FROM (
        SELECT
        'FeatureCollection' AS type,
        '212' AS id,
        array_to_json(array_agg(f)) AS features
        FROM (
        SELECT
        'Feature' AS type
        <if test="req.returnGeometry">
            ,ST_AsGeoJSON(geom)::json as geometry
        </if>
        ,(
        SELECT
        row_to_json(t)
        FROM (
        SELECT tbbh,bsm,yjjbnttbmj as area
        ) AS t
        ) AS properties
        FROM ${tableName}
        <where>
            <if test="req.tbbh != null and req.tbbh != ''">
                and tbbh like concat('%',#{req.tbbh},'%')
            </if>
        </where>
        limit ${size} offset ${offset}
        ) AS f
        ) AS fc
    </select>
    <select id="getXlsjFeaturesCount" resultType="java.lang.Integer">
        select
        count(1)
        from ${tableName}
        <where>
            <if test="req.tbbh != null and req.tbbh != ''">
                and tbbh like concat('%',#{req.tbbh},'%')
            </if>
        </where>
    </select>

    <delete id="deleteBadData">
        delete from ${tableName} where YJJBNTTBMJ is null or TBBH is null or DLMC is null
    </delete>

</mapper>
