    <select id="getLayerArea" resultType="java.lang.Double">
        select
            sum(xbmj)
        from ${tableName}
    </select>

    <delete id="deleteBadData">
        delete from ${tableName}
        where bsm is null
           or tbbh is null
           or xiao_ban is null
           or xbmj is null
           or di_lei is null
           or you_shi_sz is null
           or sen_lin_lb is null
    </delete>

    <select id="forestLayerXmList" resultType="java.util.Map">
        select
            ST_AsGeoJSON(geom)::json as geometry,
            gid,
            minx,
            miny,
            maxx,
            maxy,
            layertype,
            calarea,
            bsm,
            ${fields}
        from ${tableName}
            ${whereSql}
        limit ${size} offset ${offset}
    </select>

    <sql id="forestLayerXmListQuery">
        <where>
            <if test="req.youShiSz != null and req.youShiSz != ''">
                and you_shi_sz = #{req.youShiSz}
            </if>
            <if test="req.diLei != null and req.diLei != ''">
                and di_lei = #{req.diLei}
            </if>
            <if test="req.xiaoBan != null and req.xiaoBan != ''">
                and xiao_ban like concat('%',#{req.xiaoBan},'%')
            </if>
        </where>
    </sql>
    <select id="inspectionRoute" resultType="java.lang.String"
            parameterType="com.chinatower.gis.api.entity.layer.GetXjxlFeaturesByIdsReq">
        SELECT
        row_to_json(fc)
        FROM (
        SELECT
        'FeatureCollection' AS type,
        '212' AS id,
        array_to_json(array_agg(f)) AS features
        FROM (
        SELECT
        'Feature' AS type
        <if test="req.returnGeometry">
            ,ST_AsGeoJSON(geom)::json as geometry
        </if>
        ,(
        SELECT
        row_to_json(t)
        FROM (
        SELECT tbbh,bsm,xiao_ban,xbmj,di_lei,you_shi_sz,sen_lin_lb
        <if test="req.returnAllCols">
            ,gid,
            minx,
            miny,
            maxx,
            maxy,
            layertype,
            calarea,
            concat(sheng,'0000') as sheng,
            xian,
            concat(xian,xiang,'000') as xiang,
            concat(xian,xiang,cun) as cun,
            lin_ye_ju,
            lin_chang,
            di_mao,
            hai_ba,
            po_xiang,
            po_wei,
            po_du,
            jt_qw,
            qykz,
            tu_rang_lx,
            tu_ceng_hd,
            ld_qs,
            tdsyqs,
            lin_ban,
            xiao_ban,
            ld_kd,
            ld_cd,
            zbfglx,
            qi_yuan,
            ling_zu,
            yu_bi_du,
            disaster_c,
            dispe,
            pingjun_xj,
            pingjun_sg,
            mei_gq_zs,
            mei_gq_xj,
            huo_lmxj,
            sheng_wu_l,
            tan_chu_l,
            lmsyqs,
            lmqs,
            stqw,
            stqwmc,
            g_cheng_lb,
            sen_lin_lb,
            lin_zhong,
            gjgyl_bhdj,
            shiquan_d,
            sf_tbq,
            lyfq,
            ldgh_gl,
            bh_dj,
            zl_dj,
            td_th_lx
        </if>
        ) AS t
        ) AS properties
        FROM ${tableName}
        <where>
            <if test="req.tbbhs != null and req.tbbhs.size() > 0">
                and bsm in
                <foreach collection="req.tbbhs" item="item"  open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
        </where>
        ) AS f
        ) AS fc
    </select>

    <select id="inspectionRouteCount" resultType="java.lang.Integer">
        select
        count(1)
        from ${tableName}
        <where>
            <if test="req.tbbhs != null and req.tbbhs.size() > 0">
                and bsm in
                <foreach collection="req.tbbhs" item="item"  open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
        </where>
    </select>
    <select id="forestLayerXmListCount" resultType="java.lang.Long">
        select
            count(gid)
        from ${tableName}
        ${whereSql}
    </select>

    <select id="forestLayerLegendRes" resultType="com.chinatower.gis.api.entity.layer.ForestLayerLegendRes">
        SELECT
            #{fieldName} fieldCode,
            ${fieldName} fieldValue,
            CAST(sum(xbmj) as DECIMAL(18,2)) as totalMj
        FROM ${tableName}
        GROUP BY ${fieldName}
    </select>

    <select id="forestLayerXmInfo" resultType="java.util.Map">
        select
            ST_AsGeoJSON(geom)::json as geometry,
            gid,
            minx,
            miny,
            maxx,
            maxy,
            layertype,
            calarea,
            bsm,
            ${allFields}
        from ${tableName}
        <where>
            <if test="gid != null">
                and gid = #{gid}
            </if>
            <if test="bsm != null and bsm != ''">
                and bsm = #{bsm}
            </if>
        </where>
        limit 1 offset 0
    </select>
