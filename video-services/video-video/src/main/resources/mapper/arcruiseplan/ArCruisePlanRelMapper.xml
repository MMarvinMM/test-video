<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinatower.video.modules.arcruiseplan.mapper.ArCruisePlanRelMapper">

    <select id="countPlanByDeviceCode" resultType="java.lang.Integer">
        SELECT count(1)
        FROM vm_patrol_info_merge_t
        WHERE device_code = #{arViewId}
          AND (
                    if_cruise = '2'
                OR start_stop = '2')
    </select>
</mapper>
