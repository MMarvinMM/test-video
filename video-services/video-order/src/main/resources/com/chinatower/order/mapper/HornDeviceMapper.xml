<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinatower.order.mapper.HornDeviceMapper">

    <select id="selectExistDeviceCodeByCodes" resultType="java.lang.String">
        select device_code
        from vm_horn_device_info_t
        where delete_flag = '0'
        and device_code in
        <foreach collection="deviceCodeList" item="item" index="index" open="(" separator="," close=") ">
            #{item}
        </foreach>
    </select>
</mapper>
