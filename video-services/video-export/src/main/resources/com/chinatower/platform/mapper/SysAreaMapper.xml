<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinatower.platform.mapper.SysAreaMapper">

    <resultMap id="BaseResultMap" type="com.chinatower.platform.entity.admin.SysArea">
        <id property="id" column="id" jdbcType="BIGINT"/>
        <result property="areaCode" column="area_code" jdbcType="VARCHAR"/>
        <result property="areaName" column="area_name" jdbcType="VARCHAR"/>
        <result property="areaLevel" column="area_level" jdbcType="VARCHAR"/>
        <result property="areaParentCode" column="area_parent_code" jdbcType="VARCHAR"/>
        <result property="areaParentName" column="area_parent_name" jdbcType="VARCHAR"/>
        <result property="status" column="status" jdbcType="VARCHAR"/>
        <result property="longitude" column="longitude" jdbcType="VARCHAR"/>
        <result property="latitude" column="latitude" jdbcType="VARCHAR"/>
        <result property="createBy" column="create_by" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateBy" column="update_by" jdbcType="VARCHAR"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
        <result property="delFlag" column="del_flag" jdbcType="VARCHAR"/>
        <result property="deptId" column="dept_id" jdbcType="VARCHAR"/>
        <result property="bussnessUnit" column="bussness_unit" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="selectSysAreaSql">
        select t.id, t.area_code, t.area_name, t.area_level, t.area_parent_code, t.area_parent_name, t.create_by, t.create_time
        from ebike_admin.sys_area t where t.del_flag = '0'
    </sql>

    <select id="selectSysAreaList" parameterType="com.chinatower.platform.entity.admin.SysArea" resultType="com.chinatower.platform.entity.admin.SysArea">
        <include refid="selectSysAreaSql"/>
        <if test="areaName != null and areaName != ''"> and t.area_name = #{areaName}</if>
        <if test="areaParentName != null and areaParentName != ''"> and t.area_parent_name = #{areaParentName}</if>
        <if test="status != null and status != ''"> and t.status = #{status}</if>
    </select>
</mapper>
