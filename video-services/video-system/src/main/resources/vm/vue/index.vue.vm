<template>
  <div class="app-container">
    <el-form :model="queryParams" ref="queryForm" label-width="100px">
      <el-row :gutter="10">
#foreach($column in $columns)
#if($column.query)
#set($dictType=$column.dictType)
#set($AttrName=$column.javaField.substring(0,1).toUpperCase() + ${column.javaField.substring(1)})
#set($parentheseIndex=$column.columnComment.indexOf("（"))
#if($parentheseIndex != -1)
#set($comment=$column.columnComment.substring(0, $parentheseIndex))
#else
#set($comment=$column.columnComment)
#end
#if($column.htmlType == "input")
        <el-col :span="8">
          <el-form-item label="${comment}" prop="${column.javaField}">
            <el-input
              v-model.trim="queryParams.${column.javaField}"
              placeholder="请输入${comment}"
              clearable
              @keyup.enter.native="handleQuery"
            ></el-input>
          </el-form-item>
        </el-col>
#elseif($column.htmlType == "select" || $column.htmlType == "radio")
        <el-col :span="8">
          <el-form-item label="${comment}" prop="${column.javaField}">
            <el-select v-model="queryParams.${column.javaField}" placeholder="请选择${comment}" clearable >
              <el-option
                v-for="dict in dictOptions['$dictType']"
                :key="dict.dictValue"
                :label="dict.dictLabel"
                :value="dict.dictValue"
              ></el-option>
            </el-select>
          </el-form-item>
        </el-col>
#elseif($column.htmlType == "datetime")
        <el-col :span="8">
          <el-form-item label="${comment}" prop="${column.javaField}">
            <el-date-picker
                clearable
                v-model="queryParams.${column.javaField}"
                type="date"
                value-format="yyyy-MM-dd"
                placeholder="选择${comment}">
            </el-date-picker>
          </el-form-item>
        </el-col>

#end
#end
#end
      </el-row>
      <el-row :gutter="10" class="mb-10">
        <el-col :span="12" style="min-height: 10px;">
          <el-button type="primary" icon="el-icon-plus" @click="handleAdd"
                 v-hasPermi="['${moduleName}:${businessName}:add']" >新增</el-button>
          <el-button icon="el-icon-delete" :disabled="table.ids.length === 0" @click="handleBatchDelete"
                 v-hasPermi="['${moduleName}:${businessName}:remove']" >批量删除</el-button>
          <el-button icon="el-icon-download" @click="handleExport"
                 v-hasPermi="['${moduleName}:${businessName}:export']" >导出</el-button>
        </el-col>
        <el-col :span="12" style="text-align: right;">
          <el-button type="primary" icon="el-icon-search"  @click="handleQuery">搜索</el-button>
          <el-button icon="el-icon-refresh-left"  @click="resetQuery">重置</el-button>
        </el-col>
      </el-row>
    </el-form>
    <hr class="custom-hr" />
    <el-table v-loading="table.loading" :data="table.rows" @selection-change="handleSelected" border>
      <el-table-column type="selection" width="55" align="center" fixed="left" ></el-table-column>
#foreach($column in $columns)
#set($javaField=$column.javaField)
#set($parentheseIndex=$column.columnComment.indexOf("（"))
#if($parentheseIndex != -1)
#set($comment=$column.columnComment.substring(0, $parentheseIndex))
#else
#set($comment=$column.columnComment)
#end
#if($column.pk)
      <el-table-column label="${comment}" align="center" prop="${javaField}" width="100" ></el-table-column>
#elseif($column.list && $column.htmlType == "datetime")
      <el-table-column label="${comment}" align="center" prop="${javaField}" width="180" :formatter="tableTimeFormat"></el-table-column>
#elseif($column.list && ${column.dictType})
      <el-table-column label="${comment}" align="center" prop="${javaField}" :formatter="${javaField}Format" width="100" ></el-table-column>
#elseif($column.list && "" != $javaField)
      <el-table-column label="${comment}" align="center" prop="${javaField}" width="100" ></el-table-column>
#end
#end
      <el-table-column label="操作" align="center" fixed="right" width="150">
        <template slot-scope="scope">
          <el-button type="text" icon="el-icon-edit" @click="handleUpdate(scope.row)"
            v-hasPermi="['${moduleName}:${businessName}:edit']" >编辑</el-button>
          <el-button type="text" icon="el-icon-delete" @click="handleDelete(scope.row)"
            v-hasPermi="['${moduleName}:${businessName}:remove']" >删除</el-button>
        </template>
      </el-table-column>
    </el-table>

    <pagination v-show="table.total>0" :total="table.total" :page.sync="queryParams.pageNum" :limit.sync="queryParams.pageSize" @pagination="getList"/>

    <!-- 添加或修改${functionName}对话框 -->
    <el-dialog :title="dialog.title" :visible.sync="dialog.open" @close='handleCancel'>
      <el-form ref="form" :model="form" :rules="rules" label-width="100px">
        <el-row :gutter="10">
#foreach($column in $columns)
#set($field=$column.javaField)
#if($column.insert && !$column.pk)
#if(($column.usableColumn) || (!$column.superColumn))
#set($parentheseIndex=$column.columnComment.indexOf("（"))
#if($parentheseIndex != -1)
#set($comment=$column.columnComment.substring(0, $parentheseIndex))
#else
#set($comment=$column.columnComment)
#end
#set($dictType=$column.dictType)
#if($column.htmlType == "input")
          <el-col :span="12">
            <el-form-item label="${comment}" prop="${field}">
              <el-input v-model.trim="form.${field}" placeholder="请输入${comment}" ></el-input>
            </el-form-item>
          </el-col>
#elseif($column.htmlType == "select" && "" != $dictType)
          <el-col :span="12">
            <el-form-item label="${comment}" prop="${field}">
              <el-select v-model="form.${field}" placeholder="请选择${comment}">
                <el-option v-for="dict in dictOptions['$dictType']"
                     :key="dict.dictValue"
                     :label="dict.dictLabel"
                     :value="dict.dictValue"
                ></el-option>
              </el-select>
            </el-form-item>
          </el-col>
#elseif($column.htmlType == "radio" && "" != $dictType)
          <el-col :span="12">
            <el-form-item label="${comment}" prop="${field}">
              <el-radio-group v-model="form.${field}">
                <el-radio border v-for="dict in dictOptions['$dictType']" :key="dict.dictValue" :label="dict.dictValue" >{{dict.dictLabel}}</el-radio>
              </el-radio-group>
            </el-form-item>
          </el-col>
#elseif($column.htmlType == "datetime")
          <el-col :span="12">
            <el-form-item label="${comment}" prop="${field}">
              <el-date-picker clearable v-model="form.${field}" type="date" value-format="yyyy-MM-dd" placeholder="选择${comment}"></el-date-picker>
            </el-form-item>
          </el-col>
#elseif($column.htmlType == "textarea")
          <el-col :span="24">
            <el-form-item label="${comment}" prop="${field}">
              <el-input v-model.trim="form.${field}" type="textarea" placeholder="请输入内容" show-word-limit maxlength="200"></el-input>
            </el-form-item>
          </el-col>
#end
#end
#end
#end
        </el-row>
      </el-form>
      <div slot="footer" class="dialog-footer">
        <el-button type="primary" @click="handleSubmit">确 定</el-button>
        <el-button @click="handleCancel">取 消</el-button>
      </div>
    </el-dialog>
  </div>
</template>

<script>
import {
    list${ClassName},
    get${ClassName},
    del${ClassName}ById,
    del${ClassName}ByIds,
    add${ClassName},
    update${ClassName},
    export${ClassName}
} from "@/api/modules/${moduleName}/${businessName}";

export default {
  name:"${ClassName}",
  data() {
    return {
      table:{
        /** 遮罩层 */
        loading: false,
        /** 选中数组 */
        ids: [],
        /** 表格数据 */
        rows:[],
        /** 总条数 */
        total: 0,
      },
      dialog:{
        /** 弹出层标题 */
        title: "",
        /** 是否显示弹出层 */
        open: false,
      },
      /** 日期范围 */
      dateRange: [],
      /** 查询参数 */
      queryParams: {
        pageNum: 1,
        pageSize: 10,
#foreach ($column in $columns)
#if($column.query)
        $column.javaField: undefined#if($velocityCount != $columns.size()),#end

#end
#end
      },
      /** 表单参数 */
      form: {},
      /** 表单校验 */
      rules: {},
      /** 字典枚举选项 */
      dictOptions:{},
      /** 格式化方法 */
      formatters:{}
    };
  },
  created() {
    this.getMultipleDicts([
      "sys_yes_no",
#foreach ($column in $columns)
#if(${column.dictType})
      "${column.dictType}",
#end
#end
    ]).then(response => {
      this.dictOptions = response.data;
      this.dictToFormatters(this.dictOptions,this.formatters);
      this.getList();
    });
  },
  methods: {
    /** 重置按钮操作 */
    resetQuery() {
      this.dateRange = [];
      this.resetForm("queryForm");
      this.handleQuery();
    },
    /** 搜索按钮操作 */
    handleQuery() {
      this.queryParams.pageNum = 1;
      this.getList();
    },
    /** 查询${functionName}列表 */
    getList() {
      this.table.loading = true;
      list${ClassName}(this.addDateRange(this.queryParams,this.dateRange)).then(response => {
        this.table.rows = response.rows;
        this.table.total = response.total;
        this.table.loading = false;
      });
    },
    /** 表单重置  */
    reset() {
      this.resetForm("form");
      this.form = {};
    },
    /** 多选框选中数据  */
    handleSelected(selection) {
      this.table.ids = selection.map(item => item.${pkColumn.javaField})
    },
    /** 新增按钮操作 */
    handleAdd() {
      this.reset();
      this.dialog.open = true;
      this.dialog.title = "新增${functionName}";
      this.$nextTick(()=>{
          this.#[[$]]#refs["form"].clearValidate();
      })
    },
    /** 修改按钮操作 */
    handleUpdate(row) {
      this.reset();
      get${ClassName}(row.${pkColumn.javaField}).then(response => {
        this.form = response.data;
        this.dialog.open = true;
        this.dialog.title = "修改${functionName}";
        this.$nextTick(()=>{
            this.#[[$]]#refs["form"].clearValidate();
        })
      });
    },
    handleBatchDelete(){
      const ${pkColumn.javaField}s = this.table.ids;
      this.$confirm('是否确认删除选中的数据项?', "警告", {
        confirmButtonText: "确定",
        cancelButtonText: "取消",
        type: "warning"
      }).then(() => {
        del${ClassName}ByIds(${pkColumn.javaField}s).then((response) => {
          if(response.code == 200){
            this.getList();
            this.#[[$]]#message.success("删除成功");
          }
        })
      }).catch(() => {});
    },
    /** 删除按钮操作 */
    handleDelete(row) {
      this.$confirm('是否确认删除该条数据项?', "警告", {
        confirmButtonText: "确定",
        cancelButtonText: "取消",
        type: "warning"
      }).then(() => {
        del${ClassName}ById(row.${pkColumn.javaField}).then((response) => {
          if(response.code == 200){
            this.getList();
            this.#[[$]]#message.success("删除成功");
          }
        })
      }).catch(() => {});
    },
    /** 导出按钮操作 */
    handleExport() {
      this.exportExcel(export${ClassName}(), this.addDateRange(this.queryParams,this.dateRange), "${functionName}导出文件");
    },
    /** 提交按钮 */
    handleSubmit() {
      this.#[[$]]#refs["form"].validate(valid => {
        if (valid) {
          if (this.form.${pkColumn.javaField} != undefined) {
            update${ClassName}(this.form).then(response => {
              if (response.code === 200) {
                this.#[[$]]#message.success("修改成功");
                this.dialog.open = false;
                this.getList();
              } else {
                this.#[[$]]#message.error(response.msg);
              }
            });
          } else {
            add${ClassName}(this.form).then(response => {
              if (response.code === 200) {
                this.#[[$]]#message.success("新增成功");
                this.dialog.open = false;
                this.getList();
              } else {
                this.#[[$]]#message.error(response.msg);
              }
            });
          }
        }
      });
    },
    /** 取消按钮  */
    handleCancel() {
      this.dialog.open = false;
      this.reset();
    }
  }
};
</script>