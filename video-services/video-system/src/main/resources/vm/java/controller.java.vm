package ${packageName}.controller;

import java.util.List;

import com.github.pagehelper.PageHelper;
import com.github.pagehelper.PageInfo;
import io.swagger.annotations.Api;
import io.swagger.annotations.ApiOperation;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import com.chinatower.log.annotation.TowerLog;
import ${packageName}.domain.${ClassName};
import ${packageName}.service.I${ClassName}Service;
import com.chinatower.platform.framework.web.controller.BaseController;
import com.chinatower.platform.framework.web.domain.AjaxResult;
import com.chinatower.platform.common.utils.poi.ExcelUtil;
import com.chinatower.platform.framework.web.page.TableDataInfo;
import javax.servlet.http.HttpServletResponse;

/**
 * ${functionName}管理
 *
 * @author ${author}
 * @date ${datetime}
 */
@Api(tags = "${functionName}管理")
@RestController
@RequestMapping("/${moduleName}/${className}")
public class ${ClassName}Controller extends BaseController {

    @Autowired
    private I${ClassName}Service ${className}Service;

    @Value("${maxPageSize.oracle}")
    private int maxPageSize;


    @ApiOperation("查询${functionName}列表")
    @PreAuthorize("@ss.hasPermi('${permissionPrefix}:list')")
    @GetMapping("/list")
    public TableDataInfo list(${ClassName} ${className}) {
        startPage();
        List<${ClassName}> list = ${className}Service.select${ClassName}List(${className});
        return getDataTable(list);
    }


    @ApiOperation("导出${functionName}列表")
    @PreAuthorize("@ss.hasPermi('${permissionPrefix}:export')")
    @TowerLog(title = "${functionName}", businessType = BusinessType.EXPORT)
    @PostMapping("/export")
    public void export(@RequestBody ${ClassName} ${className}, HttpServletResponse response) throws Exception {
        PageHelper.startPage(1, (int) maxPageSize);
        List<${ClassName}> list = ${className}Service.select${ClassName}List(${className});
        PageInfo<${ClassName}> pageInfo =new PageInfo<>(list);
        if(pageInfo.getPages()>1){
            for(int i=2;i<=pageInfo.getPages();i++){
                PageHelper.startPage(i, (int) maxPageSize);
                list.addAll(${className}Service.select${ClassName}List(${className}));
            }
        }
        byte[] data =new ExcelUtil<>(${ClassName}.class).exportBytes(list);
        FileUtils.download(response, data);
    }


    @ApiOperation("获取${functionName}详细信息")
    @PreAuthorize("@ss.hasPermi('${permissionPrefix}:query')")
    @GetMapping(value = "/{${pkColumn.javaField}}")
    public AjaxResult getInfo(@PathVariable("${pkColumn.javaField}") ${pkColumn.javaType} ${pkColumn.javaField}) {
        return AjaxResult.success(${className}Service.select${ClassName}ById(${pkColumn.javaField}));
    }


    @ApiOperation("新增${functionName}")
    @PreAuthorize("@ss.hasPermi('${permissionPrefix}:add')")
    @TowerLog(title = "${functionName}", businessType = BusinessType.INSERT)
    @PostMapping
    public AjaxResult add(@RequestBody ${ClassName} ${className}) {
        return toAjax(${className}Service.insert${ClassName}(${className}));
    }


    @ApiOperation("修改${functionName}")
    @PreAuthorize("@ss.hasPermi('${permissionPrefix}:edit')")
    @TowerLog(title = "${functionName}", businessType = BusinessType.UPDATE)
    @PostMapping
    public AjaxResult edit(@RequestBody ${ClassName} ${className}) {
        return toAjax(${className}Service.update${ClassName}(${className}));
    }

    @ApiOperation("批量删除${functionName}")
    @PreAuthorize("@ss.hasPermi('${permissionPrefix}:remove')")
    @TowerLog(title = "${functionName}", businessType = BusinessType.DELETE)
    @GetMapping("/ids/{${pkColumn.javaField}s}")
    public AjaxResult remove(@PathVariable ${pkColumn.javaType}[] ${pkColumn.javaField}s) {
        return toAjax(${className}Service.delete${ClassName}ByIds(${pkColumn.javaField}s));
    }

    @ApiOperation("删除${functionName}")
    @PreAuthorize("@ss.hasPermi('${permissionPrefix}:remove')")
    @TowerLog(title = "${functionName}", businessType = BusinessType.DELETE)
	@GetMapping("/id/{${pkColumn.javaField}}")
    public AjaxResult remove(@PathVariable ${pkColumn.javaType} ${pkColumn.javaField}) {
        return toAjax(${className}Service.delete${ClassName}ById(${pkColumn.javaField}));
    }
}
