<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinatower.platform.project.pushsys.mapper.MessageMapper">
    <update id="updateCustomer" parameterType="com.chinatower.system.api.model.CustomerVO">
        UPDATE vm_order_customer
        <set>
            <if test="customerName != null">
                customer_name = #{customerName},
            </if>
            <if test="admin != null">
                admin = #{admin},
            </if>
            <if test="password != null">
                `PASSWORD` = #{password},
            </if>
            <if test="validTime != null">
                valid_time = #{validTime},
            </if>
            <if test="invalidTime != null">
                invalid_time = #{invalidTime},
            </if>
        </set>
        WHERE tenant_id = #{customerCode}
        <if test="orderCode != null">
        and order_code = #{orderCode}
        </if>
    </update>


    <update id="updateTenant" parameterType="com.chinatower.system.api.model.TenantVO">
        UPDATE sys_tenant_info
        <set>
            <if test="tenantName != null">
                tenant_name = #{tenantName},
            </if>
            update_time = now()
        </set>
        WHERE tenant_id = #{tenantId}
    </update>


    <update id="updateUser" parameterType="com.chinatower.system.api.model.TenantVO">
        UPDATE sys_user
        <set>
            is_tenant_admin ='0',
            update_time = now()
        </set>
        WHERE tenant_id = #{tenantId} and  is_tenant_admin="1"
    </update>


    <select id="getCustomer"  resultType="com.chinatower.system.api.model.CustomerVO"
            parameterType="java.lang.String">
        SELECT * FROM vm_order_customer WHERE tenant_id = #{customerCode} AND delete_flag = '1' LIMIT 1
    </select>














</mapper>