<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinatower.platform.project.system.mapper.SysRoleIndustryAuthMapper">

	<resultMap type="com.chinatower.platform.project.system.domain.SysRoleIndustryAuth" id="SysRoleTradeResult">
		<result property="roleId"     column="role_id"      />
		<result property="authId"     column="auth_id"      />
		<result property="tenantId"     column="tenant_id"      />
	</resultMap>

	<insert id="batchInsert">
		insert into sys_role_industry_auth (role_id,auth_id,tenant_id)
		values
		<foreach collection="list" item="item" separator=",">
			<trim prefix="(" suffix=")" suffixOverrides=",">
				#{item.roleId},
				#{item.authId},
				#{item.tenantId}
			</trim>
		</foreach>
	</insert>

	<delete id="deleteByRole" parameterType="Long">
		delete from sys_role_industry_auth where role_id = #{roleId}
	</delete>

	<delete id="deleteByRoleIdList" parameterType="java.util.List">
		delete from sys_role_industry_auth where role_id in
		<foreach collection="roleIdList" item="item" index="index" open="(" close=")" separator=",">
			#{item}
		</foreach>
	</delete>

	<select id="checkMenuExistRole" resultType="Integer">
		select count(1) from sys_menu a , sys_industry_auth b ,sys_role_industry_auth c
		where a.menu_id = b.menu_id and b.auth_id = c.auth_id and a.menu_id = #{menuId}
	</select>

	<select id="selectAuthIdByMenuId" resultType="Long">
		select auth_id from sys_industry_auth where industry_code=#{industryCode} and app_ver_code = #{appVerCode} and menu_id in
		<foreach collection="menuIds" item="item" index="index" open="(" close=")" separator=",">
			#{item}
		</foreach>
	</select>
</mapper>
