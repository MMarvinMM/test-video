<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinatower.platform.project.system.mapper.ScreenMenuConfMapper">




    <select id="getScreenMenuConf"  resultType="com.chinatower.system.api.model.ScreenMenuConfVO" parameterType="com.chinatower.system.api.model.ScreenMenuConfVO">
        SELECT
        id,
        group_id,
        attr,
        tab_name,
        industry_view_id,
        industry_view_type,
        view_type,
        sort,
        tenant_id,
        industry_code,
        app_ver_code
        FROM
        screen_menu_conf
        where
        delete_flag = 0

        <if test="tenantId != null and tenantId != ''">
            and tenant_id = #{tenantId}
        </if>
        <if test="industryCode != null and industryCode != ''">
            and industry_code = #{industryCode}
        </if>
        <if test="appVerCode != null and appVerCode != ''">
            and app_ver_code = #{appVerCode}
        </if>

        ORDER BY sort ASC
    </select>


    <select id="getMaxSort"  resultType="java.lang.Integer" parameterType="com.chinatower.system.api.model.ScreenMenuConfVO">
        SELECT
        case when MAX(sort) is null then -1 else MAX(sort) end
        FROM
        screen_menu_conf
        where
        delete_flag = 0
        <if test="tenantId != null and tenantId != ''">
            and tenant_id = #{tenantId}
        </if>
        <if test="industryCode != null and industryCode != ''">
            and industry_code = #{industryCode}
        </if>
        <if test="appVerCode != null and appVerCode != ''">
            and app_ver_code = #{appVerCode}
        </if>
    </select>

    <delete id="deleteScreenMenuConf" parameterType="com.chinatower.system.api.model.ScreenMenuConfVO">
 		delete from screen_menu_conf where
        tenant_id = #{tenantId} and  industry_code = #{industryCode} and  app_ver_code = #{appVerCode}
 	</delete>


    <insert id="insertScreenMenuConf" parameterType="com.chinatower.system.api.model.ScreenMenuConfVO" >
        insert into screen_menu_conf(group_id,attr,tab_name,industry_view_id,industry_view_type,view_type,sort,delete_flag,tenant_id,industry_code,app_ver_code,creator,create_time) values
        <foreach open="" collection="list" item="item"  close="" separator=",">
            (#{item.groupId},#{item.attr},#{item.tabName},#{item.industryViewId},#{item.industryViewType},#{item.viewType},#{item.sort},0,#{item.tenantId},#{item.industryCode},#{item.appVerCode},#{item.creator},NOW())
        </foreach>
    </insert>






</mapper>
