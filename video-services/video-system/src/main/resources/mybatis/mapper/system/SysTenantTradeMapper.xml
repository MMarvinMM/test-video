    <select id="countTenantTrade" resultType="int">
        select count(*)
        from sys_tenant_trade where tenant_id = #{tenantId}
        and industry_code = #{industryCode} and app_ver_code = #{appVerCode}
    </select>


    <insert id="insertTenantTrade" useGeneratedKeys="false"  parameterType="com.chinatower.platform.entity.admin.SysTenantTrade">
        insert into sys_tenant_trade(tenant_id,industry_code,app_ver_code)
        values (#{tenantId}, #{industryCode}, #{appVerCode})
    </insert>

    <insert id="batchInsertTenantTrade">
        insert into sys_tenant_trade(tenant_id,industry_code,app_ver_code)
        values
        <foreach collection="tenantTrades" item="item" separator=",">
            (#{tenantId}, #{item.industryCode}, #{item.appVerCode})
        </foreach>
    </insert>

    <delete id="delTenantTrade" parameterType="string">
		delete from sys_tenant_trade where tenant_id = #{tenantId}
	</delete>

