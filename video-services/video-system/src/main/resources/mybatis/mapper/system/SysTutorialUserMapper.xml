<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinatower.platform.project.system.mapper.SysTutorialUserMapper">

    <resultMap id="BaseResultMap" type="com.chinatower.platform.project.system.domain.SysTutorialUser" >
        <id column="tutorial_id" property="tutorialId" />
        <result column="tutorail_title" property="tutorailTitle" />
        <result column="file_url" property="fileUrl" />
        <result column="tenant_is_look" property="tenantIsLook" />
        <result column="tower_is_look" property="towerIsLook" />
        <result column="remarks" property="remarks" />
        <result column="creator" property="creator" />
        <result column="create_time" property="createTime" />
        <result column="update_by" property="updateBy" />
        <result column="update_time" property="updateTime" />
        <result column="delete_flag" property="deleteFlag" />
        <result column="file_name" property="fileName" />
        <result column="industry_code" property="industryCode" />
        <result column="industry_name" property="industryName" />
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyColumn="tutorial_id" keyProperty="tutorialId" parameterType="com.chinatower.platform.project.system.domain.SysTutorialUser">
        INSERT INTO sys_tutorial_user
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="null != tutorailTitle and '' != tutorailTitle">
                tutorail_title,
            </if>
            <if test="null != fileUrl and '' != fileUrl">
                file_url,
            </if>
            <if test="null != tenantIsLook">
                tenant_is_look,
            </if>
            <if test="null != towerIsLook">
                tower_is_look,
            </if>
            <if test="null != remarks and '' != remarks">
                remarks,
            </if>
            <if test="null != creator and '' != creator">
                creator,
            </if>
            <if test="null != createTime">
                create_time,
            </if>
            <if test="null != updateBy and '' != updateBy">
                update_by,
            </if>
            <if test="null != updateTime">
                update_time,
            </if>
            <if test="null != deleteFlag and '' != deleteFlag">
                delete_flag,
            </if>
            <if test="null != fileName and '' != fileName">
                file_name,
            </if>
            <if test="null != industryCode and '' != industryCode">
                industry_code
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="null != tutorailTitle and '' != tutorailTitle">
                #{tutorailTitle},
            </if>
            <if test="null != fileUrl and '' != fileUrl">
                #{fileUrl},
            </if>
            <if test="null != tenantIsLook">
                #{tenantIsLook},
            </if>
            <if test="null != towerIsLook">
                #{towerIsLook},
            </if>
            <if test="null != remarks and '' != remarks">
                #{remarks},
            </if>
            <if test="null != creator and '' != creator">
                #{creator},
            </if>
            <if test="null != createTime">
                #{createTime},
            </if>
            <if test="null != updateBy and '' != updateBy">
                #{updateBy},
            </if>
            <if test="null != updateTime">
                #{updateTime},
            </if>
            <if test="null != deleteFlag and '' != deleteFlag">
                #{deleteFlag},
            </if>
            <if test="null != fileName and '' != fileName">
                #{fileName},
            </if>
            <if test="null != industryCode and '' != industryCode">
                #{industryCode}
            </if>
        </trim>
    </insert>

    <delete id="delete" >
        DELETE FROM sys_tutorial_user
        WHERE tutorial_id = #{tutorialId}
    </delete>

    <update id="update" parameterType="com.chinatower.platform.project.system.domain.SysTutorialUser">
        UPDATE sys_tutorial_user
        <set>
            <if test="null != tutorailTitle and '' != tutorailTitle">tutorail_title = #{tutorailTitle},</if>
            <if test="null != fileUrl and '' != fileUrl">file_url = #{fileUrl},</if>
            <if test="null != tenantIsLook">tenant_is_look = #{tenantIsLook},</if>
            <if test="null != towerIsLook">tower_is_look = #{towerIsLook},</if>
            <if test="null != remarks and '' != remarks">remarks = #{remarks},</if>
            <if test="null != updateBy and '' != updateBy">update_by = #{updateBy},</if>
            <if test="null != updateTime">update_time = #{updateTime},</if>
            <if test="null != deleteFlag and '' != deleteFlag">delete_flag = #{deleteFlag},</if>
            <if test="null != fileName and '' != fileName">file_name = #{fileName},</if>
            <if test="null != industryCode and '' != industryCode">industry_code = #{industryCode}</if>
        </set>
        WHERE tutorial_id = #{tutorialId}
    </update>


    <select id="load" resultMap="BaseResultMap">
        SELECT
        t1.tutorial_id,
        t1.tutorail_title,
        t1.file_url,
        t1.tenant_is_look,
        t1.tower_is_look,
        t1.remarks,
        t1.creator,
        t1.create_time,
        t1.update_by,
        t1.update_time,
        t1.delete_flag,
        t1.file_name,
        t1.industry_code,
        case when t1.tenant_is_look = '1' AND t1.tower_is_look = '0' then '客户'
        when t1.tenant_is_look = '0' AND t1.tower_is_look = '1' then '铁塔'
        when t1.tenant_is_look = '1' AND t1.tower_is_look = '1' then '铁塔，客户'  end as visibility
        FROM sys_tutorial_user t1
        WHERE t1.tutorial_id = #{tutorialId}
    </select>

    <select id="pageList" resultMap="BaseResultMap" parameterType="com.chinatower.platform.project.system.domain.SysTutorialUser">
        SELECT
        t1.tutorial_id,
        t1.tutorail_title,
        t1.file_url,
        t1.tenant_is_look,
        t1.tower_is_look,
        t1.remarks,
        t1.creator,
        t1.create_time,
        t1.update_by,
        t1.update_time,
        t1.delete_flag,
        t1.file_name,
        t1.industry_code,
        case when t1.tenant_is_look = '1' AND t1.tower_is_look = '0' then '客户'
        when t1.tenant_is_look = '0' AND t1.tower_is_look = '1' then '铁塔'
        when t1.tenant_is_look = '1' AND t1.tower_is_look = '1' then '铁塔，客户'  end as visibility
        FROM sys_tutorial_user t1
        <where>
            <if test="null != tutorialId and '' != tutorialId"> and t1.tutorial_id = #{tutorialId}</if>
            <if test="null != tutorailTitle and '' != tutorailTitle"> and t1.tutorail_title like CONCAT('%',#{tutorailTitle},'%') </if>
            <if test="null != fileUrl and '' != fileUrl"> and t1.file_url = #{fileUrl}</if>
            <if test="null != tenantIsLook"> and t1.tenant_is_look = #{tenantIsLook}</if>
            <if test="null != towerIsLook"> and t1.tower_is_look = #{towerIsLook}</if>
            <if test="null != remarks and '' != remarks"> and t1.remarks = #{remarks}</if>
            <if test="null != creator and '' != creator"> and t1.creator like CONCAT('%',#{creator},'%')</if>
            <if test="null != createTime"> and t1.create_time = #{createTime}</if>
            <if test="null != updateBy and '' != updateBy"> and t1.update_by like CONCAT('%',#{updateBy},'%')</if>
            <if test="null != updateTime"> and t1.update_time = #{updateTime}</if>
            <if test="null != deleteFlag and '' != deleteFlag"> and t1.delete_flag = #{deleteFlag}</if>
            <if test="null != visibility and '' != visibility">
                <if test='visibility == "1"'>
                    and t1.tenant_is_look = '0' and t1.tower_is_look = '1'
                </if>
                <if test='visibility == "2"'>
                    and t1.tenant_is_look = '1' and t1.tower_is_look = '0'
                </if>
                <if test='visibility == "3"'>
                    and t1.tenant_is_look = '1' and t1.tower_is_look = '1'
                </if>
             </if>
            <if test="createTimeStart != null and createTimeStart != ''">
                AND t1.create_time BETWEEN  DATE_FORMAT(#{createTimeStart},'%y-%m-%d 00:00:00') AND DATE_FORMAT(#{createTimeEnd},'%y-%m-%d 23:59:59')
            </if>
            <if test="updateTimeStart != null and updateTimeStart != ''">
                AND t1.update_time BETWEEN  DATE_FORMAT(#{updateTimeStart},'%y-%m-%d 00:00:00') AND DATE_FORMAT(#{updateTimeEnd},'%y-%m-%d 23:59:59')
            </if>
            <if test="null != industryCode and '' != industryCode"> and t1.industry_code like CONCAT('%',#{industryCode},'%')</if>
            <if test="industryCodeList != null and industryCodeList.size() > 0 ">
                AND
                <foreach collection="industryCodeList" item="industryCode" index="index" open="(" close=")" separator="or">
                    FIND_IN_SET(#{industryCode},t1.industry_code)
                </foreach>
            </if>
        </where>
        <choose>
            <when test="orderByColumn != null and orderByColumn != '' and isAsc != null and isAsc != '' ">
                <choose>
                    <when test='orderByColumn == "createTime"'>
                        order by t1.create_time
                        <if test='isAsc == "desc"'>
                            desc
                        </if>
                    </when>
                    <when test='orderByColumn == "updateTime"'>
                        order by t1.update_time
                        <if test='isAsc == "desc"'>
                            desc
                        </if>
                    </when>
                    <otherwise>
                        order by t1.create_time desc,t1.tutorial_id desc
                    </otherwise>
                </choose>
            </when>
            <otherwise>
                order by t1.create_time desc,t1.tutorial_id desc
            </otherwise>
        </choose>
    </select>

    <select id="checkRepeat" resultType="java.lang.String" parameterType="com.chinatower.platform.project.system.domain.SysTutorialUser">
        SELECT tutorial_id
        FROM sys_tutorial_user
        where tutorail_title=#{tutorailTitle,jdbcType=VARCHAR} and delete_flag = 0
        <if test='tutorialId != null and tutorialId != ""'>
            and tutorial_id != #{tutorialId}
        </if>
        limit 1
    </select>

    <select id="getIndustryList" resultType="com.chinatower.platform.project.system.domain.vo.TutorialIndustryVO">
        SELECT
        industry_code,
        industry_name
        FROM
        sys_industry_conf where delete_flag = 0 and industry_code != '999999'
    </select>

</mapper>