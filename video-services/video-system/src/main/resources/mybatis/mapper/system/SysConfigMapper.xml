<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinatower.platform.project.system.mapper.SysConfigMapper">

    <resultMap type="com.chinatower.platform.project.system.domain.SysConfig" id="SysConfigResult">
    	<id     property="configId"      column="config_id"      />
        <result property="configName"    column="config_name"    />
        <result property="configKey"     column="config_key"     />
        <result property="configValue"   column="config_value"   />
        <result property="configType"    column="config_type"    />
        <result property="creator"      column="creator"      />
        <result property="createTime"    column="create_time"    />
        <result property="modifier"      column="modifier"      />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectConfigVo">
        select config_id, config_name, config_key, config_value, config_type, creator, create_time, modifier, update_time, remark
		from sys_config
    </sql>

    <sql id="exportConfigVo">
        select config_id, config_name, config_key, config_value, case when config_type = 0 then '否' else '是' end config_type, creator, create_time, modifier, update_time, remark
		from sys_config
    </sql>

    <select id="selectConfig" parameterType="com.chinatower.platform.project.system.domain.SysConfig" resultMap="SysConfigResult">
        <include refid="selectConfigVo"/>
        <where>
            <if test="configId !=null">
                and config_id = #{configId}
            </if>
            <if test="configKey !=null and configKey != ''">
                and config_key = #{configKey}
            </if>
        </where>
    </select>

    <select id="getMsgConfig" parameterType="String" resultType="String">
        select flag
        from sys_msg_config
        where app_ver_code = #{appVerCode}
        limit 1
    </select>

    <select id="selectConfigList" parameterType="com.chinatower.platform.project.system.domain.SysConfig" resultMap="SysConfigResult">
        <include refid="selectConfigVo"/>
        <where>
			<if test="configName != null and configName != ''">
				AND config_name like CONCAT(CONCAT('%', #{configName}),'%')
			</if>
			<if test="configType != null and configType != ''">
				AND config_type = #{configType}
			</if>
			<if test="configKey != null and configKey != ''">
				AND config_key like CONCAT(CONCAT('%', #{configKey}),'%')
			</if>
			<if test="beginTime != null and beginTime != ''"><!-- 开始时间检索 -->
                AND create_time &gt;= STR_TO_DATE(CONCAT(#{beginTime}, ' 00:00:00'),'%Y-%m-%d %H:%i:%s %T')
            </if>
			<if test="endTime != null and endTime != ''"><!-- 结束时间检索 -->
                AND create_time &lt;= STR_TO_DATE(CONCAT(#{endTime}, ' 23:59:59'),'%Y-%m-%d %H:%i:%s %T')
            </if>
		</where>
        order by
        <choose>
            <when test='orderByColumn != null and orderByColumn != ""'>
                <choose>
                    <when test='orderByColumn == "configId"'>CONFIG_ID</when>
                    <when test='orderByColumn == "configName"'>CONFIG_NAME</when>
                    <when test='orderByColumn == "configKey"'>CONFIG_KEY</when>
                    <when test='orderByColumn == "configValue"'>CONFIG_VALUE</when>
                    <when test='orderByColumn == "configType"'>CONFIG_TYPE</when>
                    <when test='orderByColumn == "createTime"'>create_time</when>
                    <otherwise>create_time</otherwise>
                </choose>
                <choose>
                    <when test='isAsc != null and isAsc == "asc"'>ASC</when>
                    <otherwise>DESC</otherwise>
                </choose>,
                CONFIG_ID DESC
            </when>
            <otherwise>
                create_time DESC, CONFIG_ID DESC
            </otherwise>
        </choose>
    </select>

    <select id="exportConfigList" parameterType="com.chinatower.platform.project.system.domain.SysConfig" resultMap="SysConfigResult">
        <include refid="exportConfigVo"/>
        <where>
            <if test="configName != null and configName != ''">
                AND config_name like CONCAT(CONCAT('%', #{configName}),'%')
            </if>
            <if test="configType != null and configType != ''">
                AND config_type = #{configType}
            </if>
            <if test="configKey != null and configKey != ''">
                AND config_key like CONCAT(CONCAT('%', #{configKey}),'%')
            </if>
            <if test="beginTime != null and beginTime != ''"><!-- 开始时间检索 -->
                AND create_time &gt;= STR_TO_DATE(CONCAT(#{beginTime}, ' 00:00:00'),'%Y-%m-%d %H:%i:%s %T')
            </if>
            <if test="endTime != null and endTime != ''"><!-- 结束时间检索 -->
                AND create_time &lt;= STR_TO_DATE(CONCAT(#{endTime}, ' 23:59:59'),'%Y-%m-%d %H:%i:%s %T')
            </if>
        </where>
        ORDER BY CREATE_TIME ASC
    </select>

    <select id="selectConfigListByConfigIds" parameterType="com.chinatower.platform.project.system.domain.SysConfig" resultMap="SysConfigResult">
        <include refid="selectConfigVo"/>
        where config_id in
        <foreach item="configId" collection="array" open="(" separator="," close=")">
            #{configId}
        </foreach>
    </select>

    <select id="checkConfigKeyUnique" parameterType="String" resultMap="SysConfigResult">
        <include refid="selectConfigVo"/>
        where config_key = #{configKey}
    </select>
    <select id="selectAll" resultType="com.chinatower.platform.project.system.domain.SysConfig">
        select config_id, config_name, config_key, config_value, config_type, creator, create_time, modifier, update_time, remark
        from sys_config
    </select>

    <insert id="insertConfig" parameterType="com.chinatower.platform.project.system.domain.SysConfig">
        insert into sys_config (
			<if test="configName != null and configName != '' ">config_name,</if>
			<if test="configKey != null and configKey != '' ">config_key,</if>
			<if test="configValue != null and configValue != '' ">config_value,</if>
			<if test="configType != null and configType != '' ">config_type,</if>
			<if test="creator != null and creator != ''">creator,</if>
			<if test="remark != null and remark != ''">remark,</if>
 			create_time
        )values(
			<if test="configName != null and configName != ''">#{configName},</if>
			<if test="configKey != null and configKey != ''">#{configKey},</if>
			<if test="configValue != null and configValue != ''">#{configValue},</if>
			<if test="configType != null and configType != ''">#{configType},</if>
			<if test="creator != null and creator != ''">#{creator},</if>
			<if test="remark != null and remark != ''">#{remark},</if>
 			#{createTime}
		)
    </insert>

    <update id="updateConfig" parameterType="com.chinatower.platform.project.system.domain.SysConfig">
        update sys_config
        <set>
            <if test="configName != null and configName != ''">config_name = #{configName},</if>
            <if test="configKey != null and configKey != ''">config_key = #{configKey},</if>
            <if test="configValue != null and configValue != ''">config_value = #{configValue},</if>
            <if test="configType != null and configType != ''">config_type = #{configType},</if>
            <if test="modifier != null and modifier != ''">modifier = #{modifier},</if>
            <if test="remark != null">remark = #{remark},</if>
 			update_time = #{updateTime}
        </set>
        where config_id = #{configId}
    </update>

    <delete id="deleteConfigById" parameterType="Long">
        delete from sys_config where config_id = #{configId}
    </delete>

    <delete id="deleteConfigByIds" parameterType="Long">
        delete from sys_config where config_id in
        <foreach item="configId" collection="array" open="(" separator="," close=")">
        	#{configId}
        </foreach>
    </delete>

    <select id="selectConfigListByConfigKeys" resultMap="SysConfigResult">
        <include refid="selectConfigVo"/>
        <where>
            config_key in
            <foreach collection="configKeys" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </where>
    </select>


</mapper>
