<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
		PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
		"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinatower.platform.project.mapper.SysUserMapper">
	<select id="selectUserPhone" resultType="java.lang.String" parameterType="java.lang.String">
		SELECT PHONENUMBER  from sys_user where user_name = #{userName} and DEL_FLAG = '0' and STATUS = '0' limit 1
    </select>
</mapper>
